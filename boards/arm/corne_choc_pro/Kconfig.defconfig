# Keebart Corne Choc Pro BT, modified so the RIGHT half is the ZMK central.
# The central owns the keyboard identity, host Bluetooth/USB connection,
# keymap/layer state, and receives events from the left peripheral.
if BOARD_CORNE_CHOC_PRO_RIGHT

config ZMK_KEYBOARD_NAME
    default "Corne Choc Pro"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# One BLE connection is used by the left split peripheral in addition to the
# five normal host profiles. ZMK recommends sizing both values accordingly.
config BT_MAX_CONN
    default 6

config BT_MAX_PAIRED
    default 6

endif # BOARD_CORNE_CHOC_PRO_RIGHT

if BOARD_CORNE_CHOC_PRO_LEFT || BOARD_CORNE_CHOC_PRO_RIGHT

config BOARD
    default "corne_choc_pro"

config ZMK_SPLIT
    default y

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

config BT_CTLR
    default BT

config I2C
    default y

config ZMK_MAX17048
    default y

endif # BOARD_CORNE_CHOC_PRO_LEFT || BOARD_CORNE_CHOC_PRO_RIGHT
